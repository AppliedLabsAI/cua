#!/usr/bin/env bash
# Pre-commit hook: runs ruff lint, ruff format check, and ty type check.
# Operates only on staged Python files for speed.
#
# Setup: git config core.hooksPath .githooks

set -e

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')

if [ -z "$STAGED_PY" ]; then
    exit 0
fi

echo "pre-commit: ruff check"
uv run ruff check $STAGED_PY

echo "pre-commit: ruff format --check"
uv run ruff format --check $STAGED_PY

echo "pre-commit: ty check"
uv run ty check
